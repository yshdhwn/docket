# Frontend (build-time): turn on real image analysis
VITE_REAL_IMAGE_API=true

# Server only (set in Vercel -> Project Settings -> Environment Variables; never prefix with VITE_)
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
# Optional: override the model
# GEMINI_MODEL=gemini-3.8-flash
